{
  "name": "@anthropic-ai/claude-code-source",
  "version": "2.1.88",
  "description": "Claude Code v2.1.88 — decompiled source for research",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare-src": "node scripts/prepare-src.mjs",
    "build": "npm run prepare-src && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "validate:providers": "node --import tsx scripts/validate-provider-registry.ts",
    "smoke:providers": "node --import tsx scripts/provider-adapter-smoke.ts",
    "smoke:runtime-selection": "node --import tsx scripts/provider-runtime-selection-smoke.ts",
    "smoke:test-route": "node --import tsx scripts/provider-test-route-smoke.ts",
    "smoke:payloads": "node --import tsx scripts/provider-request-payload-smoke.ts",
    "smoke:mcp": "node --import tsx scripts/mcp-smoke.ts",
    "check:mcp": "node --import tsx scripts/check-mcp-ui.ts",
    "verify:mcp": "npm run check:mcp && npm --prefix webui run build && npm run smoke:mcp",
    "check:providers": "npm run validate:providers && npm run smoke:providers && npm run smoke:runtime-selection && npm run smoke:payloads && npm run smoke:test-route",
    "start": "node dist/cli.js",
    "dev:server": "node --import tsx --watch src/server/start-local-web.ts",
    "dev:cli": "node --import tsx --watch src/entrypoints/cli.tsx",
    "dev:web": "vite --config webui/vite.config.ts",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.4",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.46",
    "@anthropic-ai/sdk": "^0.81.0",
    "@clack/core": "^1.2.0",
    "@clack/prompts": "^1.2.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@growthbook/growthbook": "^1.6.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@vitejs/plugin-react": "^6.0.1",
    "axios": "^1.14.0",
    "bidi-js": "^1.0.3",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "chardet": "^2.1.1",
    "chokidar": "^5.0.0",
    "cli-cursor": "^5.0.0",
    "cli-spinners": "^3.4.0",
    "cli-truncate": "^5.2.0",
    "color-diff-napi": "^0.0.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "diff": "^8.0.4",
    "env-paths": "^4.0.0",
    "execa": "file:./stubs/execa-stub",
    "express": "^5.2.1",
    "figures": "^6.1.0",
    "get-stream": "^9.0.1",
    "glob": "^13.0.6",
    "has-flag": "^5.0.1",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^9.0.0",
    "ignore": "^7.0.5",
    "ink": "^6.8.0",
    "is-interactive": "^2.0.0",
    "json-stable-stringify": "^1.3.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.17.23",
    "lru-cache": "^11.2.7",
    "marked": "^17.0.5",
    "minimist": "^1.2.8",
    "mixpanel-browser": "^2.77.0",
    "p-map": "^7.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "^7.8.2",
    "semver": "^7.7.4",
    "signal-exit": "^4.1.0",
